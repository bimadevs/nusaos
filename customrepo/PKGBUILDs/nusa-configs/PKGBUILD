depends=('hyprland' 'waybar' 'kitty' 'rofi-wayland' 'starship' 'zsh' 'dunst')
source=()
sha256sums=()

package() {
    # Salin seluruh pohon skel ke /etc/skel/
    install -d "${pkgdir}/etc/skel"
    cp -r "${startdir}/skel/." "${pkgdir}/etc/skel/"
}
